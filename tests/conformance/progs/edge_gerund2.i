	PLEASE NOTE GERUNDS STASHING, RETRIEVING, IGNORING,
	DO NOTE REMEMBERING, ABSTAINING, REINSTATING, COMING FROM
	DO .1 <- #1
	DO ABSTAIN FROM STASHING
	PLEASE STASH .1
	DO .1 <- #2
	DO REINSTATE STASHING
	DO STASH .1
	PLEASE .1 <- #3
	DO ABSTAIN FROM RETRIEVING
	DO RETRIEVE .1
	DO READ OUT .1
	PLEASE REINSTATE RETRIEVING
	DO RETRIEVE .1
	DO READ OUT .1
	DO ABSTAIN FROM IGNORING
	PLEASE IGNORE .1
	DO .1 <- #4
	DO READ OUT .1
	DO REINSTATE IGNORING
	PLEASE IGNORE .1
	DO ABSTAIN FROM REMEMBERING
	DO REMEMBER .1
	DO .1 <- #5
	PLEASE READ OUT .1
	DO REINSTATE REMEMBERING
	DO REMEMBER .1
	DO .1 <- #6
	PLEASE READ OUT .1
	DO ABSTAIN FROM ABSTAINING
	DO ABSTAIN FROM READING OUT
	DO READ OUT #7
	PLEASE REINSTATE ABSTAINING
	DO ABSTAIN FROM COMING FROM
(50)	DO .1 <- #9
	DO READ OUT .1
	DO REINSTATE COMING FROM
(60)	PLEASE .1 <- #10
	DO READ OUT #60
	DO GIVE UP
	DO COME FROM (50)
	PLEASE READ OUT #50
	DO COME FROM (60)
	DO READ OUT .1
	PLEASE NOTE ONCE REINSTATING IS ABSTAINED IT STAYS ABSTAINED FOREVER
	DO ABSTAIN FROM REINSTATING
	DO ABSTAIN FROM CALCULATING
	DO REINSTATE CALCULATING
	PLEASE .1 <- #8
	DO READ OUT .1
	DO REINSTATE ABSTAINING + REINSTATING
	DO REINSTATE CALCULATING
	PLEASE .1 <- #11
	DO READ OUT .1
	DO GIVE UP
